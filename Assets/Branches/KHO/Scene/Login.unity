  m_text: "\uB2F9\uC2E0\uC740 \uC5B4\uB5A0\uD55C \uC774\uC720\uB85C \uC5C4\uCCAD\uB09C
    \uC591\uC758 \uBE5A\uC744\n\uC84C\uC2B5\uB2C8\uB2E4... \uADF8\uB7F0 \uB2F9\uC2E0\uC758
    \uBE5A\uC744 \uAC1A\uAE30\n\uC704\uD574\uC11C\uB294 \uB8F0\uB81B\uC744 \uB3CC\uB824\uC57C\uB9CC
